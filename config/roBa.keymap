#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&trackball {
    // automouse-layer = <4>;

    scroll-layers = <3>;

    // arrows {
    //     layers = <3>;
    //     bindings =
    //         <&kp RIGHT_ARROW>,
    //         <&kp LEFT_ARROW>,
    //         <&kp UP_ARROW>,
    //         <&kp DOWN_ARROW>;
    //     tick = <10>;
    //     wait-ms = <5>;
    //     tap-ms = <5>;
    // };
};

/ {
    combos { compatible = "zmk,combos"; };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q  &kp W         &kp E    &kp R                      &kp T                                                 &kp Y             &kp U  &kp I      &kp O    &kp P
&kp A  &kp S         &kp D    &kp F                      &kp G             &lt 3 PRINTSCREEN      &kp LC(TAB)  &kp H             &kp J  &kp K      &kp L    &kp SEMI
&kp Z  &kp X         &kp C    &kp V                      &kp B             &mo 2                  &kp LS(F10)  &kp N             &kp M  &kp COMMA  &kp DOT  &kp SLASH
&none  &kp LEFT_ALT  &kp TAB  &mt LEFT_SHIFT LANGUAGE_2  &mt LCTRL ESCAPE  &kp SPACE              &kp ENTER    &lt 2 LANGUAGE_1                             &kp ESCAPE
            >;
        };

        aml {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans    &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &mkp MB4  &mkp MB1  &mkp MB3  &mkp MB2  &mkp MB5
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans    &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                                  &trans
            >;
        };

        layer1 {
            bindings = <
&kp NUMBER_1  &kp NUMBER_2    &kp NUMBER_3    &kp NUMBER_4    &kp N5                               &kp NUMBER_6   &kp N7          &kp N8            &kp N9             &kp N0
&kp GRAVE     &kp LEFT_ARROW  &kp UP_ARROW    &kp RIGHT       &none         &none           &none  &kp MINUS      &kp EQUAL       &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp NON_US_BACKSLASH
&none         &none           &kp DOWN_ARROW  &none           &none         &none           &none  &kp BACKSPACE  &msc SCRL_DOWN  &msc SCRL_UP      &none              &none
&none         &none           &none           &kp LEFT_SHIFT  &kp LEFT_WIN  &kp ESCAPE      &none  &none                                                               &none
            >;
        };

        layer2 {
            bindings = <
&kp F1        &kp F2        &kp F3  &kp F4  &kp F5                       &kp F6    &kp F7    &kp F8    &kp F9    &kp F10
&none         &none         &none   &none   &none      &none      &none  &mkp MB4  &mkp MB1  &mkp MB3  &mkp MB2  &mkp MB5
&none         &none         &none   &none   &none      &none      &none  &none     &none     &none     &none     &none
&bt BT_SEL 0  &bt BT_SEL 1  &none   &none   &kp LCTRL  &none      &none  &none                                   &none
            >;
        };

        layer3 {
            bindings = <
&none  &none  &none  &none  &none                        &none  &none  &none  &none  &none
&none  &none  &none  &none  &none      &none      &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none      &none      &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &kp LCTRL  &none      &none  &none                       &none
            >;
        };
    };
};
